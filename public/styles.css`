:root {
    --bg-black: #000000;
    --bg-dark: #0a0a0a;
    --accent-yellow: #EAB308;
    --text-white: #FFFFFF;
    --text-slate: #94A3B8;
    --border-dark: #1a1a1a;
    --glass-bg: rgba(0, 0, 0, 0.7);
    --transition-fast: all 0.2s cubic-bezier(0.23, 1, 0.32, 1);
    --transition-smooth: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    --radius-lg: 24px;
    --radius-md: 16px;
    --container-max: 1300px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: var(--bg-black);
    color: var(--text-white);
    overflow-x: hidden;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

/* TYPOGRAPHY */
h1, h2, h3, h4 {
    font-weight: 700;
    letter-spacing: -0.03em;
}

.mono-label, .mono-tag, .outcome-mono {
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent-yellow);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* NAVIGATION */
nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    z-index: 1000;
    transition: var(--transition-smooth);
}

.nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-dark);
    border-radius: 100px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-white);
}

.logo-v {
    background: var(--accent-yellow);
    color: black;
    font-weight: 900;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 14px;
}

.logo-text {
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.5px;
}

.nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
}

.nav-link {
    color: var(--text-slate);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: var(--transition-fast);
}

.nav-link:hover {
    color: var(--text-white);
}

.cta-nav {
    background: var(--accent-yellow);
    color: black;
    padding: 8px 16px;
    border-radius: 100px;
    font-weight: 600;
}

.cta-nav:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
}

/* HERO SECTION */
.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 20px;
    background: #000;
    position: relative;
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
}

.orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.2;
    animation: float 25s infinite alternate ease-in-out;
}

.orb-1 {
    width: 700px;
    height: 700px;
    background: var(--accent-yellow);
    top: -10%;
    left: -10%;
    animation-delay: 0s;
}

.orb-2 {
    width: 600px;
    height: 600px;
    background: var(--accent-yellow);
    bottom: -10%;
    right: -10%;
    animation-delay: -8s;
}

.orb-3 {
    width: 400px;
    height: 400px;
    background: var(--accent-yellow);
    top: 40%;
    right: 20%;
    opacity: 0.1;
    animation-duration: 30s;
}

.grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.08) 1px, transparent 0);
    background-size: 50px 50px;
    mask-image: radial-gradient(circle at center, black 20%, transparent 80%);
    z-index: 1;
}

@keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(15%, 10%) scale(1.2); }
    66% { transform: translate(-10%, 20%) scale(0.8); }
    100% { transform: translate(0, 0) scale(1); }
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
}

.badge {
    background: rgba(234, 179, 8, 0.1);
    color: var(--accent-yellow);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(234, 179, 8, 0.2);
    margin-bottom: 24px;
    display: inline-block;
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

.hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(40px, 8vw, 80px);
    line-height: 1.1;
    margin-bottom: 24px;
    animation: fadeInUp 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    opacity: 0;
}

.hero-subtitle {
    font-size: clamp(18px, 3vw, 24px);
    color: var(--text-slate);
    max-width: 650px;
    margin: 0 auto 40px auto;
    animation: fadeInUp 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    opacity: 0;
}

.hero-actions {
    animation: fadeInUp 1.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    opacity: 0;
}

.btn-primary {
    background: var(--accent-yellow);
    color: black;
    padding: 18px 36px;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: var(--transition-fast);
    box-shadow: 0 0 30px rgba(234, 179, 8, 0.4);
}

.btn-primary:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
    box-shadow: 0 0 50px rgba(234, 179, 8, 0.6);
}

/* SECTIONS */
.section {
    padding: 140px 20px;
    position: relative;
}

.container {
    max-width: var(--container-max);
    margin: 0 auto;
}

.section-header {
    text-align: center;
    margin-bottom: 80px;
}

.section-title {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    margin-bottom: 16px;
}

.section-desc {
    color: var(--text-slate);
    font-size: 18px;
    max-width: 600px;
    margin: 0 auto;
}

/* BENTO GRID */
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 24px;
}

.bento-item {
    background: var(--bg-dark);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
    overflow: hidden;
    transition: var(--transition-smooth);
    z-index: 1;
}

.bento-item:hover {
    border-color: var(--accent-yellow);
    transform: translateY(-8px) scale(1.01);
    box-shadow: 0 20px 40px -15px rgba(234, 179, 8, 0.3);
}

.bento-item.large {
    grid-column: span 2;
    grid-row: span 2;
}

.bento-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.bento-item h3 {
    font-size: 24px;
    margin-bottom: 12px;
}

.bento-item p {
    color: var(--text-slate);
    font-size: 16px;
    margin-bottom: 24px;
}

.bento-link {
    color: var(--accent-yellow);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition-fast);
}

.bento-link:hover {
    gap: 12px;
}

.bento-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
        600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(234, 179, 8, 0.1),
        transparent 40%
    );
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
}

.bento-item:hover::before {
    opacity: 1;
}

/* OUTCOMES */
.outcomes-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.outcome-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding: 40px;
    background: var(--bg-dark);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    align-items: center;
    transition: var(--transition-smooth);
}

.outcome-card:hover {
    border-color: var(--accent-yellow);
    background: rgba(234, 179, 8, 0.02);
    transform: translateX(10px);
}

.outcome-info h3 {
    font-size: 32px;
    margin-bottom: 12px;
}

.outcome-info p {
    color: var(--text-slate);
    font-size: 18px;
}

.outcome-visual {
    height: 200px;
    background: linear-gradient(45deg, #111, #050505);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-dark);
    position: relative;
    overflow: hidden;
}

/* FOOTER */
footer {
    padding: 100px 20px 40px 20px;
    border-top: 1px solid var(--border-dark);
    background: var(--bg-black);
}

.footer-container {
    max-width: var(--container-max);
    margin: 0 auto;
}

.footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 80px;
    margin-bottom: 60px;
}

.footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.footer-brand p {
    color: var(--text-slate);
    max-width: 350px;
}

.footer-nav h4 {
    margin-bottom: 24px;
    font-size: 16px;
}

.footer-nav ul {
    list-style: none;
}

.footer-nav li {
    margin-bottom: 12px;
}

.footer-nav a {
    color: var(--text-slate);
    text-decoration: none;
    font-size: 14px;
    transition: var(--transition-fast);
}

.footer-nav a:hover {
    color: var(--text-white);
}

.footer-bottom {
    text-align: center;
    padding-top: 40px;
    border-top: 1px solid var(--border-dark);
    color: var(--text-slate);
    font-size: 14px;
}

/* GLOBAL ANIMATIONS */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* MOBILE RESPONSIVENESS */
@media (max-width: 1024px) {
    .bento-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    nav {
        width: 95%;
    }
    .nav-links {
        display: none;
    }
    .hero-title {
        font-size: clamp(32px, 10vw, 48px);
    }
    .bento-grid {
        grid-template-columns: 1fr;
    }
    .bento-item.large {
        grid-column: span 1;
    }
    .outcome-card {
        grid-template-columns: 1fr;
        gap: 30px;
        text-align: center;
    }
    .footer-main {
        grid-template-columns: 1fr;
        text-align: center;
    }
    .footer-brand {
        align-items: center;
    }
}
